# macOS üzerindeki yerel PostgreSQL için; uygulamaya ait ayrı veritabanı.
BILANCO_DATABASE_URL=postgresql:///bilanco
BILANCO_DATA_DIR=./data
# SEC, otomatik isteklerde gerçek bir iletişim bilgisi ister. Kendi adresini gir.
BILANCO_SEC_CONTACT=
# İsteğe bağlı: mevcut Codex CLI oturumunun erişebildiği model.
# Boşsa Enron CLI varsayılanı; Türkiye analyze gpt-6-luna + gpt-6.1-sol tekrar.
BILANCO_CODEX_MODEL=
BILANCO_CODEX_TIMEOUT=240
BILANCO_MAX_AI_CALLS=32
# Docker Compose kullanılırsa DSN portu 55432 olmalı; parolayı kendin belirle.
# BILANCO_DB_PASSWORD=
